#!/usr/bin/env python3
"""Generate hyprswitch + overview themes from Caelestia's current scheme."""
import json
import os
import re

HOME = os.path.expanduser("~")
SCHEME = os.path.join(HOME, ".config/hypr/scheme/current.lua")
OUT = os.path.join(HOME, ".config/hyprswitch/theme.css")
JSON_OUT = os.path.join(HOME, ".config/quickshell/overview/theme.json")

fallback = {
    "background": "0f0e08",
    "surfaceContainer": "1b1a10",
    "surfaceContainerHigh": "212015",
    "surfaceContainerHighest": "27261a",
    "onSurface": "eae6d2",
    "onSurfaceVariant": "afab9a",
    "outline": "787666",
    "outlineVariant": "4a483a",
    "primary": "cec98c",
    "primaryContainer": "575423",
    "onPrimary": "444213",
    "secondary": "ccc8a4",
    "tertiary": "ffdaa8",
}

colors = dict(fallback)
try:
    with open(SCHEME) as f:
        for name, value in re.findall(r'(\w+)\s*=\s*"([0-9a-fA-F]{6})"', f.read()):
            colors[name] = value
except FileNotFoundError:
    pass


def rgb(name, alpha=1.0):
    value = colors.get(name, fallback[name])
    r, g, b = (int(value[i:i + 2], 16) for i in (0, 2, 4))
    return f"rgba({r}, {g}, {b}, {alpha:g})"


css = f""":root {{
    --border-color: {rgb("outlineVariant", 0.9)};
    --border-color-active: {rgb("primary", 1)};
    --bg-color: {rgb("background", 0.88)};
    --bg-color-hover: {rgb("surfaceContainerHigh", 0.95)};
    --index-border-color: {rgb("primary", 0.55)};
    --border-radius: 20px;
    --border-size: 2px;
}}

.window {{
    color: {rgb("onSurface", 1)};
}}

.workspace,
.monitor,
.client {{
    color: {rgb("onSurface", 1)};
}}

.workspace:hover,
.monitor:hover,
.client:hover {{
    color: {rgb("onSurface", 1)};
}}

.index {{
    color: {rgb("primary", 1)};
}}
"""

os.makedirs(os.path.dirname(OUT), exist_ok=True)
with open(OUT + ".tmp", "w") as f:
    f.write(css)
os.replace(OUT + ".tmp", OUT)

os.makedirs(os.path.dirname(JSON_OUT), exist_ok=True)
with open(JSON_OUT + ".tmp", "w") as f:
    json.dump({name: f"#{colors.get(name, fallback[name])}" for name in fallback}, f, indent=2)
os.replace(JSON_OUT + ".tmp", JSON_OUT)

print(OUT)
print(JSON_OUT)
