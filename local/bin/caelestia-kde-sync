#!/usr/bin/env python3
"""Sincroniza el esquema de colores de Caelestia con kdeglobals y GTK.

Caelestia escribe ~/.config/qtengine/caelestia.colors en cada cambio de tema.
Las apps de KDE (Dolphin, Kate, etc.) leen los grupos [Colors:*] de
~/.config/kdeglobals, así que hay que materializarlos ahí.

Además reajusta la selección de Thunar: Caelestia regenera
~/.config/gtk-*/thunar.css en cada cambio de tema, así que este hook vuelve a
inyectar el resaltado translúcido que mantiene legible el nombre del archivo.
"""

import configparser
import os
import shutil
import sys
from pathlib import Path

HOME = Path.home()
SCHEME = HOME / ".config/qtengine/caelestia.colors"
FALLBACK = HOME / ".local/share/color-schemes/Caelestia.colors"
KDEGLOBALS = HOME / ".config/kdeglobals"
SCHEME_NAME = "Caelestia"

THUNAR_MARKER = "/* caelestia-thunar-selection */"
THUNAR_BLOCK = (
    "\n" + THUNAR_MARKER + "\n"
    "/* Translucent selection so the file name stays readable in Thunar;\n"
    "   ExoIconView paints the selected item with theme_selected_bg_color. */\n"
    "@define-color theme_selected_bg_color alpha(@accent_color, 0.25);\n"
)


def patch_thunar_selection() -> None:
    for rel in ("gtk-3.0/thunar.css", "gtk-4.0/thunar.css"):
        path = HOME / ".config" / rel
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue

        kept: list[str] = []
        skip = False
        for line in lines:
            if THUNAR_MARKER in line:
                skip = True
                continue
            if skip:
                if "@define-color theme_selected_bg_color" in line:
                    skip = False
                continue
            if "@define-color theme_selected_bg_color" in line:
                continue
            if "ExoIconView paints the selected item" in line:
                continue
            kept.append(line)

        text = "\n".join(kept).rstrip()
        path.write_text(text + THUNAR_BLOCK, encoding="utf-8")

COPY_SECTIONS = (
    "ColorEffects:Disabled",
    "ColorEffects:Inactive",
    "Colors:Button",
    "Colors:Complementary",
    "Colors:Header",
    "Colors:Header][Inactive",
    "Colors:Selection",
    "Colors:Tooltip",
    "Colors:View",
    "Colors:Window",
    "WM",
)


def open_ini() -> configparser.RawConfigParser:
    parser = configparser.RawConfigParser(
        interpolation=None,
        strict=False,
        delimiters=("=",),
    )
    parser.optionxform = str
    return parser


def main() -> int:
    patch_thunar_selection()

    scheme_path = SCHEME if SCHEME.is_file() else FALLBACK
    if not scheme_path.is_file():
        print(f"caelestia-kde-sync: no se encontró {SCHEME}", file=sys.stderr)
        return 1

    scheme = open_ini()
    scheme.read(scheme_path, encoding="utf-8")

    kdeglobals = open_ini()
    if KDEGLOBALS.is_file():
        kdeglobals.read(KDEGLOBALS, encoding="utf-8")

    for section in COPY_SECTIONS:
        if not scheme.has_section(section):
            continue
        if not kdeglobals.has_section(section):
            kdeglobals.add_section(section)
        for key, value in scheme.items(section):
            kdeglobals.set(section, key, value)

    general = scheme["General"] if scheme.has_section("General") else {}
    if not kdeglobals.has_section("General"):
        kdeglobals.add_section("General")
    kdeglobals.set("General", "ColorScheme", general.get("ColorScheme", SCHEME_NAME))
    kdeglobals.remove_option("General", "ColorSchemeHash")

    tmp = KDEGLOBALS.with_suffix(".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        kdeglobals.write(fh, space_around_delimiters=False)
    os.replace(tmp, KDEGLOBALS)

    try:
        published = HOME / ".local/share/color-schemes/Caelestia.colors"
        published.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(scheme_path, published)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
