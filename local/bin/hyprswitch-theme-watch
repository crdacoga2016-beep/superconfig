#!/usr/bin/env python3
"""Keep the hyprswitch theme in sync with Caelestia's colour scheme."""
import os
import shutil
import subprocess
import time

HOME = os.path.expanduser("~")
SCHEME = os.path.join(HOME, ".config/hypr/scheme/current.lua")
THEME = os.path.join(HOME, ".local/bin/hyprswitch-theme")
INIT = [
    shutil.which("hyprswitch") or os.path.join(HOME, ".local/bin/hyprswitch"),
    "init",
    "--show-title",
    "--custom-css",
    os.path.join(HOME, ".config/hyprswitch/theme.css"),
    "--workspaces-per-row",
    "4",
    "--size-factor",
    "8",
]


def mtime():
    try:
        return os.stat(SCHEME).st_mtime
    except OSError:
        return 0


def start_daemon():
    subprocess.run([THEME], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(
        INIT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )


start_daemon()
last = mtime()

while True:
    time.sleep(2)
    current = mtime()
    if current and current != last:
        last = current
        subprocess.run(["pkill", "-x", "hyprswitch"], check=False)
        time.sleep(0.3)
        start_daemon()
